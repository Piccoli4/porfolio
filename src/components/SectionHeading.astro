---
interface Props {
  num: string
  title: string
  lead?: string
}

const { num, title, lead } = Astro.props
---

<header class="mb-10 md:mb-14" data-reveal>
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-10">
    <div>
      <p class="eyebrow mb-3" aria-hidden="true">/// {num}</p>
      <h2 class="text-4xl font-bold uppercase tracking-tight sm:text-5xl lg:text-6xl">{title}</h2>
    </div>
    {lead && <p class="max-w-sm text-base text-muted md:pb-2 md:text-right">{lead}</p>}
  </div>
  <div class="mt-6 flex h-px items-stretch bg-line" aria-hidden="true">
    <span class="-mt-px h-[3px] w-16 bg-brand-red"></span>
  </div>
</header>
