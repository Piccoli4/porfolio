---
import SectionHeading from "./SectionHeading.astro"
import { useT, type Lang } from "@/i18n/ui"
import { EXPERIENCE } from "@/data/experience"

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const t = useT(lang)
---

<section id="experiencia" class="container-site py-20 md:py-28">
  <SectionHeading num={num} title={t.sections.experience.title} lead={t.sections.experience.lead} />

  <ol class="relative">
    {
      EXPERIENCE.map((job, i) => (
        <li class="grid gap-3 md:grid-cols-[13rem_1fr] md:gap-10" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <!-- Fecha -->
          <div class="md:pt-1 md:text-right">
            <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-red-ink md:sticky md:top-28">
              {job.date[lang]}
              {job.current && (
                <span class="ml-2 inline-block bg-brand-red px-1.5 py-0.5 text-[9px] font-semibold tracking-[0.18em] text-white md:ml-auto md:mt-2 md:block md:w-fit">
                  {t.experience.current}
                </span>
              )}
            </p>
          </div>

          <!-- Contenido -->
          <div class:list={["relative border-l border-line pl-7 md:pl-10", i < EXPERIENCE.length - 1 ? "pb-14" : "pb-2"]}>
            <span class:list={["marker absolute -left-[6px] top-1.5 size-[11px] rotate-45", job.current ? "bg-brand-red" : "border-2 border-brand-red bg-bg"]} aria-hidden="true" />
            <h3 class="text-2xl font-bold leading-tight md:text-3xl">{job.role[lang]}</h3>
            <p class="mt-1.5 font-medium text-muted">{job.company[lang]}</p>

            <ul class="mt-5 space-y-2.5">
              {job.highlights[lang].map((item) => (
                <li class="bullet relative pl-6 leading-relaxed">{item}</li>
              ))}
            </ul>

            <ul class="mt-6 flex flex-wrap gap-1.5">
              {job.stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

