---
import { useT, type Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const t = useT(Astro.props.lang)
const THEMES = [
  { value: "light", label: t.theme.light },
  { value: "dark", label: t.theme.dark },
  { value: "system", label: t.theme.system },
] as const
---

<div class="theme-toggle relative">
  <button
    type="button"
    class="theme-btn grid size-9 place-items-center text-ink-2 transition-colors hover:text-ink"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={t.theme.label}
  >
    <!-- sol -->
    <svg class="icon-light size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <!-- luna -->
    <svg class="icon-dark size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
    </svg>
    <!-- sistema -->
    <svg class="icon-system size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="12" rx="1"></rect>
      <path d="M8 20h8M12 16v4"></path>
    </svg>
  </button>

  <ul
    class="theme-menu absolute right-0 top-11 z-50 hidden min-w-[9rem] border border-line bg-surface p-1 shadow-xl shadow-black/10"
    role="menu"
  >
    {
      THEMES.map((theme) => (
        <li role="none">
          <button
            type="button"
            role="menuitemradio"
            data-theme={theme.value}
            class="theme-option flex w-full items-center justify-between gap-3 px-3 py-2 text-left text-sm text-ink-2 hover:bg-surface-2 hover:text-ink"
          >
            {theme.label}
            <span class="check hidden font-mono text-xs text-red-ink">///</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .theme-btn svg {
    display: none;
  }
  :global(html[data-theme-pref="light"]) .icon-light,
  :global(html[data-theme-pref="dark"]) .icon-dark,
  :global(html[data-theme-pref="system"]) .icon-system {
    display: block;
  }
  .theme-menu.open {
    display: block;
    animation: pop 0.15s ease-out both;
  }
  .theme-option[aria-checked="true"] {
    color: rgb(var(--ink));
  }
  .theme-option[aria-checked="true"] .check {
    display: inline;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>

<script>
  const root = document.documentElement
  const media = window.matchMedia("(prefers-color-scheme: dark)")

  const getPref = () => {
    try {
      return localStorage.getItem("theme") || "system"
    } catch {
      return "system"
    }
  }

  const apply = (pref: string) => {
    const dark = pref === "dark" || (pref === "system" && media.matches)
    root.classList.toggle("dark", dark)
    root.dataset.themePref = pref
    document.querySelectorAll<HTMLElement>(".theme-option").forEach((opt) => {
      opt.setAttribute("aria-checked", String(opt.dataset.theme === pref))
    })
  }

  apply(getPref())
  media.addEventListener("change", () => getPref() === "system" && apply("system"))

  document.querySelectorAll<HTMLElement>(".theme-toggle").forEach((toggle) => {
    const btn = toggle.querySelector<HTMLButtonElement>(".theme-btn")!
    const menu = toggle.querySelector<HTMLElement>(".theme-menu")!
    const setOpen = (open: boolean) => {
      menu.classList.toggle("open", open)
      btn.setAttribute("aria-expanded", String(open))
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation()
      setOpen(!menu.classList.contains("open"))
    })
    menu.querySelectorAll<HTMLElement>(".theme-option").forEach((opt) => {
      opt.addEventListener("click", () => {
        const pref = opt.dataset.theme || "system"
        try {
          localStorage.setItem("theme", pref)
        } catch {}
        apply(pref)
        setOpen(false)
        btn.focus()
      })
    })
    document.addEventListener("click", () => setOpen(false))
    document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false))
  })
</script>
