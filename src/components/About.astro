---
import SectionHeading from "./SectionHeading.astro"
import { useT, type Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const t = useT(lang)
---

<section id="sobre-mi" class="container-site py-20 md:py-28">
  <SectionHeading num={num} title={t.sections.about.title} lead={t.sections.about.lead} />

  <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <!-- Foto -->
    <figure class="relative mx-auto w-full max-w-sm lg:sticky lg:top-28" data-reveal>
      <div class="about-photo relative aspect-[3/4] overflow-hidden bg-surface-2">
        <img
          src="/yo.webp"
          alt={t.about.photoAlt}
          width="720"
          height="960"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>
      <span class="tricolor-v absolute -left-3 top-12 h-32 w-2" aria-hidden="true"></span>
      <figcaption class="absolute -bottom-4 right-4 bg-brand-navy px-3 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-white dark:bg-surface-2">
        <span class="text-brand-red">///</span> {t.about.caption}
      </figcaption>
    </figure>

    <!-- Texto -->
    <div data-reveal style="--reveal-delay:120ms">
      <div class="space-y-5 text-lg leading-relaxed [&_strong]:font-semibold [&_strong]:text-ink">
        {t.about.paragraphs.map((p) => <p set:html={p} />)}
      </div>

      <ul class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2">
        {
          t.about.principles.map((item, i) => (
            <li class="flex items-center gap-4 bg-surface px-5 py-4">
              <span class="font-mono text-xs font-semibold text-red-ink">0{i + 1}</span>
              <span class="font-display text-base font-semibold uppercase tracking-wide text-ink">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

