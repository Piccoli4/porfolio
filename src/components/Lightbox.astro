---
// Visor compartido por Proyectos (galerías) y Formación (certificados).
// Cualquier botón con data-lightbox="<clave>" lo abre. Los datos de cada clave
// (ver src/data/lightbox.ts) se descargan de /lightbox-<lang>.json al primer uso.
import { useT, type Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useT(lang).lightbox
const dataUrl = `/lightbox-${lang}.json`
---

<dialog
  id="lightbox"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-ink-2 backdrop:bg-[#050a1c]/90 backdrop:backdrop-blur-sm"
  aria-labelledby="lb-title"
>
  <div class="flex h-full items-center justify-center p-3 sm:p-6" data-lb-backdrop>
    <div class="lb-panel flex max-h-full w-full max-w-6xl flex-col overflow-hidden border border-line bg-surface shadow-2xl">
      <header class="flex items-start justify-between gap-4 border-b border-line px-5 py-4 sm:px-6">
        <div class="min-w-0">
          <p id="lb-subtitle" class="eyebrow mb-1 truncate"></p>
          <h3 id="lb-title" class="truncate text-xl font-bold sm:text-2xl"></h3>
        </div>
        <div class="flex shrink-0 items-center gap-3">
          <span id="lb-counter" class="font-mono text-xs text-muted"></span>
          <button type="button" data-lb-close class="grid size-10 place-items-center text-ink transition-colors hover:bg-surface-2" aria-label={t.close}>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </div>
      </header>

      <div class="grid min-h-0 flex-1 grid-cols-1 overflow-y-auto lg:grid-cols-[minmax(0,1fr)_22rem] lg:overflow-hidden" id="lb-body">
        <div class="flex min-h-0 min-w-0 flex-col">
          <div class="relative flex min-h-[40vh] flex-1 items-center justify-center bg-surface-2 lg:min-h-0">
            <img id="lb-image" alt="" class="max-h-[60vh] w-full object-contain lg:max-h-[68vh]" />
            <button type="button" data-lb-prev class="lb-nav left-3" aria-label={t.prev}>
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>
            <button type="button" data-lb-next class="lb-nav right-3" aria-label={t.next}>
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
            </button>
          </div>
          <div id="lb-thumbs" class="flex gap-2 overflow-x-auto border-t border-line p-3"></div>
        </div>

        <aside id="lb-details" class="hidden border-t border-line p-5 sm:p-6 lg:overflow-y-auto lg:border-l lg:border-t-0">
          <p id="lb-description" class="text-sm leading-relaxed"></p>
          <p id="lb-skills-label" class="eyebrow mb-3 mt-6"></p>
          <ul id="lb-skills" class="flex flex-wrap gap-1.5"></ul>
        </aside>
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog[open] .lb-panel {
    animation: lb-in 0.25s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  .lb-nav {
    @apply absolute top-1/2 grid size-11 -translate-y-1/2 place-items-center bg-brand-navy/70 text-white backdrop-blur transition-colors hover:bg-brand-red;
  }
  :global(.lb-thumb) {
    @apply h-14 w-20 shrink-0 cursor-pointer object-cover opacity-60 ring-1 ring-line transition-all hover:opacity-100;
  }
  :global(.lb-thumb[aria-current="true"]) {
    @apply opacity-100 ring-2 ring-brand-red;
  }
</style>

<script define:vars={{ ofLabel: t.of, dataUrl }}>
  const dialog = document.getElementById("lightbox")
  const $ = (id) => document.getElementById(id)
  let images = []
  let index = 0
  let opener = null

  const render = () => {
    const img = $("lb-image")
    const current = images[index]
    img.src = current.src
    img.alt = current.alt || ""
    const multiple = images.length > 1
    $("lb-counter").textContent = multiple ? `${index + 1} ${ofLabel} ${images.length}` : ""
    dialog.querySelectorAll("[data-lb-prev],[data-lb-next]").forEach((b) => (b.hidden = !multiple))
    $("lb-thumbs").hidden = !multiple
    $("lb-thumbs").querySelectorAll("img").forEach((thumb, i) => {
      thumb.setAttribute("aria-current", String(i === index))
      if (i === index) thumb.scrollIntoView({ block: "nearest", inline: "center" })
    })
  }

  const open = (data, trigger) => {
    opener = trigger
    images = data.images || []
    index = data.start || 0
    $("lb-title").textContent = data.title || ""
    $("lb-subtitle").textContent = data.subtitle || ""

    const thumbs = $("lb-thumbs")
    thumbs.replaceChildren(
      ...images.map((image, i) => {
        const thumb = document.createElement("img")
        thumb.src = image.thumb || image.src
        thumb.alt = ""
        thumb.loading = "lazy"
        thumb.className = "lb-thumb"
        thumb.addEventListener("click", () => {
          index = i
          render()
        })
        return thumb
      })
    )

    const details = $("lb-details")
    const hasDetails = Boolean(data.description || data.skills?.length)
    details.classList.toggle("hidden", !hasDetails)
    $("lb-body").classList.toggle("lg:grid-cols-[minmax(0,1fr)_22rem]", hasDetails)
    $("lb-description").textContent = data.description || ""
    $("lb-skills-label").textContent = data.skillsLabel || ""
    $("lb-skills").replaceChildren(
      ...(data.skills || []).map((skill) => {
        const li = document.createElement("li")
        li.className = "chip"
        li.textContent = skill
        return li
      })
    )

    render()
    dialog.showModal()
    document.documentElement.style.overflow = "hidden"
  }

  const step = (delta) => {
    if (images.length < 2) return
    index = (index + delta + images.length) % images.length
    render()
  }

  // Descarga única y perezosa de los datos del visor
  let dataPromise = null
  const loadData = () =>
    (dataPromise ??= fetch(dataUrl)
      .then((r) => r.json())
      .catch((err) => {
        dataPromise = null
        throw err
      }))
  const prefetch = (e) => e.target.closest?.("[data-lightbox]") && loadData()
  document.addEventListener("pointerover", prefetch, { passive: true })
  document.addEventListener("focusin", prefetch)

  document.addEventListener("click", async (e) => {
    const trigger = e.target.closest("[data-lightbox]")
    if (!trigger) return
    e.preventDefault()
    const data = (await loadData())[trigger.dataset.lightbox]
    if (data) open(data, trigger)
  })
  dialog.querySelector("[data-lb-close]").addEventListener("click", () => dialog.close())
  dialog.querySelector("[data-lb-prev]").addEventListener("click", () => step(-1))
  dialog.querySelector("[data-lb-next]").addEventListener("click", () => step(1))
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog || e.target.hasAttribute("data-lb-backdrop")) dialog.close()
  })
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") step(-1)
    if (e.key === "ArrowRight") step(1)
  })
  dialog.addEventListener("close", () => {
    document.documentElement.style.overflow = ""
    opener?.focus()
  })
</script>
