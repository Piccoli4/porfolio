---
import Logo from "./Logo.astro"
import LanguagePicker from "./LanguagePicker.astro"
import ThemeToggle from "./ThemeToggle.astro"
import { useT, type Lang } from "@/i18n/ui"
import { getSections } from "@/i18n/nav"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useT(lang)
const sections = getSections(lang)
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="container-site flex h-16 items-center justify-between gap-6 md:h-20">
    <!-- Lockup: isotipo + PICCOLI / AUGUSTO -->
    <a href={`/${lang}/`} class="group flex items-center gap-3" aria-label={`Piccoli Augusto — ${t.nav.home}`}>
      <Logo class="h-7 w-auto text-brand-red transition-transform duration-300 group-hover:-translate-y-0.5 md:h-8" />
      <span class="h-7 w-px bg-line" aria-hidden="true"></span>
      <span class="font-display text-[11px] font-semibold uppercase leading-[1.2] tracking-[0.24em] text-ink" aria-hidden="true">
        Piccoli<br />Augusto
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Principal">
      <ul class="flex items-center gap-7">
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`} data-nav={s.id} class="slash-link py-2 text-sm font-medium text-ink-2 transition-colors hover:text-ink aria-[current=true]:text-ink">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <div class="hidden sm:block"><LanguagePicker lang={lang} /></div>
      <ThemeToggle lang={lang} />
      <a href={t.cv.file} download class="btn-primary btn-sm hidden sm:inline-flex">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"></path>
        </svg>
        CV
        <span class="sr-only">— {t.cv.label}</span>
      </a>
      <button
        id="menu-btn"
        type="button"
        class="grid size-10 place-items-center text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menu}
        data-label-open={t.nav.menu}
        data-label-close={t.nav.close}
      >
        <span class="menu-lines relative block h-3.5 w-6" aria-hidden="true">
          <span class="absolute left-0 top-0 h-0.5 w-6 bg-current transition-transform duration-300"></span>
          <span class="absolute bottom-0 right-0 h-0.5 w-4 bg-brand-red transition-all duration-300"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Menú mobile -->
  <div id="mobile-menu" class="hidden h-[calc(100dvh-4rem)] overflow-y-auto border-t border-line bg-bg lg:hidden">
    <nav class="container-site py-6" aria-label="Mobile">
      <ol class="space-y-1">
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="flex items-baseline gap-4 py-2.5 font-display text-2xl font-semibold text-ink">
                <span class="font-mono text-xs text-red-ink">{s.num}</span>
                {s.label}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="mt-6 flex items-center justify-between border-t border-line pt-5">
        <LanguagePicker lang={lang} />
        <a href={t.cv.file} download class="btn-primary btn-sm">{t.cv.label}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  #site-header[data-scrolled="true"],
  #site-header[data-open="true"] {
    background: rgb(var(--bg) / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(var(--line));
  }
  #site-header[data-open="true"] #mobile-menu {
    display: block;
  }
  #site-header[data-open="true"] .menu-lines span:first-child {
    transform: translateY(6px) rotate(45deg);
  }
  #site-header[data-open="true"] .menu-lines span:last-child {
    width: 1.5rem;
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById("site-header")!
  const menuBtn = document.getElementById("menu-btn") as HTMLButtonElement
  const menu = document.getElementById("mobile-menu")!

  // Fondo al hacer scroll
  const onScroll = () => header.setAttribute("data-scrolled", String(window.scrollY > 12))
  onScroll()
  window.addEventListener("scroll", onScroll, { passive: true })

  // Menú mobile
  const setOpen = (open: boolean) => {
    header.setAttribute("data-open", String(open))
    menuBtn.setAttribute("aria-expanded", String(open))
    menuBtn.setAttribute("aria-label", (open ? menuBtn.dataset.labelClose : menuBtn.dataset.labelOpen) || "")
  }
  menuBtn.addEventListener("click", () => setOpen(header.dataset.open !== "true"))
  menu.querySelectorAll("a[href^='#']").forEach((a) => a.addEventListener("click", () => setOpen(false)))
  document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false))
  window.matchMedia("(min-width: 1024px)").addEventListener("change", () => setOpen(false))

  // Sección activa en la navegación
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]")
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        links.forEach((link) => link.setAttribute("aria-current", String(link.dataset.nav === entry.target.id)))
      }
    },
    { rootMargin: "-45% 0px -50% 0px" }
  )
  document.querySelectorAll("main section[id]").forEach((section) => observer.observe(section))
</script>
