---
import { LANGS, useT, type Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useT(lang)
---

<nav aria-label={t.lang.label} class="flex items-center font-mono text-xs font-semibold tracking-wider">
  {
    LANGS.map((code, i) => (
      <>
        {i > 0 && <span class="px-1 text-muted/60" aria-hidden="true">/</span>}
        <a
          href={`/${code}/`}
          hreflang={code}
          lang={code}
          aria-current={code === lang ? "page" : undefined}
          title={code === lang ? undefined : t.lang.switchTo}
          class:list={[
            "px-1 py-1 uppercase transition-colors",
            code === lang ? "text-red-ink" : "text-muted hover:text-ink",
          ]}
        >
          {code}
        </a>
      </>
    ))
  }
</nav>
